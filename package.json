{
  "name": "pilcrow",
  "version": "1.0.0",
  "private": true,
  "license": "(MIT AND CC-BY-NC-SA-4.0)",
  "description": "Personal pilcrow (¶) brandmark — favicon, brand assets, and design history",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "fetch": "node scripts/fetch-joan.mjs",
    "build:marks": "node scripts/build-marks.mjs",
    "build:raster": "node scripts/build-raster.mjs",
    "build:favicon": "node scripts/build-favicon.mjs",
    "build:palette": "node scripts/build-palette.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build": "npm run fetch && npm run build:marks && npm run build:raster && npm run build:favicon && npm run build:palette && npm run build:site",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "fontkitten": "^1.0.3",
    "globals": "^17.12.0",
    "marked": "^18.0.12",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "svgo": "^4.1.0",
    "vitest": "^5.0.0"
  }
}
